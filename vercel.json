    {
      "source": "/results",
      "destination": "/front/pantallas/results"
    },
    {
      "source": "/statistics",
      "destination": "/front/pantallas/statistics"
    },
    {
      "source": "/submit-result",
      "destination": "/front/pantallas/submit-result"
    },
    {
      "source": "/tablon",
      "destination": "/front/pantallas/tablon"
    },
    {
      "source": "/tournaments",
      "destination": "/front/pantallas/tournaments"
    },
    {
      "source": "/valorar",
      "destination": "/front/pantallas/valorar"
    }
  ]
}
