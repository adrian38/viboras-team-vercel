{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/site.webmanifest",
      "has": [{ "type": "host", "value": ".*-git-dev-.*\\.vercel\\.app" }],
      "destination": "/front/iconos-dev/site.webmanifest"
    },
    {
      "source": "/site.webmanifest",
      "destination": "/front/iconos/site.webmanifest"
    },
    {
      "source": "/apple-touch-icon.png",
      "has": [{ "type": "host", "value": ".*-git-dev-.*\\.vercel\\.app" }],
      "destination": "/front/iconos-dev/apple-touch-icon.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/front/iconos/apple-touch-icon.png"
    },
    {
      "source": "/",
      "destination": "/front/pantallas/portada"
    },
    {
      "source": "/index.html",
      "destination": "/front/pantallas/portada"
    },
    {
      "source": "/buzon",
      "destination": "/front/pantallas/buzon"
    },
    {
      "source": "/comunidad",
      "destination": "/front/pantallas/comunidad"
    },
    {
      "source": "/cuenta",
      "destination": "/front/pantallas/cuenta"
    },
    {
      "source": "/day",
      "destination": "/front/pantallas/day"
    },
    {
      "source": "/group-normativa",
      "destination": "/front/pantallas/group-normativa"
    },
    {
      "source": "/history",
      "destination": "/front/pantallas/history"
    },
    {
      "source": "/inscripcion",
      "destination": "/front/pantallas/inscripcion"
    },
    {
      "source": "/players",
      "destination": "/front/pantallas/players"
    },
    {
      "source": "/pozo",
      "destination": "/front/pantallas/pozo"
    },
    {
      "source": "/pozo-info",
      "destination": "/front/pantallas/pozo-info"
    },
    {
      "source": "/pozo-nuevo",
      "destination": "/front/pantallas/pozo-nuevo"
    },
    {
      "source": "/ranking",
      "destination": "/front/pantallas/ranking"
    },
    {
      "source": "/ranking-info",
      "destination": "/front/pantallas/ranking-info"
    },
    {
      "source": "/rating",
