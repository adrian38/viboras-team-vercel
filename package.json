{
  "name": "padel-app",
  "version": "1.0.0",
  "description": "Padel league app migrated from Netlify Functions/Blobs to Vercel + Vercel Postgres",
  "type": "module",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "schema": "node scripts/apply-schema.js",
    "check": "node tools/ai-context-index.mjs && node tools/rating-parity.mjs && node tools/code-size.mjs && node tools/palette.mjs && node tools/barra-navegacion.mjs",
    "check:index": "node tools/ai-context-index.mjs",
    "check:rating": "node tools/rating-parity.mjs",
    "check:size": "node tools/code-size.mjs",
    "export:encuestas": "node scripts/exportar-encuestas.mjs",
    "push:dev:partido": "node tools/notificarme-dev.mjs partido_terminado",
    "push:dev:opinion": "node tools/notificarme-dev.mjs opinion_partido",
    "push:dev:torneo": "node tools/notificarme-dev.mjs resultados_torneo",
    "push:dev:todas": "node tools/notificarme-dev.mjs todas"
  },
  "dependencies": {
    "@vercel/postgres": "^0.10.0",
    "jose": "^6.2.12",
    "nodemailer": "10.0.13",
    "web-push": "^3.6.7"
  }
}
